# Server key for the extraction model (required unless users bring their own key)
ANTHROPIC_API_KEY=
# Model used for reading papers (long documents). Check the Anthropic docs for current ids.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Supabase Postgres (Session pooler string). If empty, data are stored in ./data/fields/*.json
DATABASE_URL=
# Required to download all fields from /api/admin/export
ADMIN_TOKEN=
# Optional: restrict who can create and edit fields (leave empty for open access)
ACCESS_CODE=
# Shown to OpenAlex for the polite pool (faster rate limits)
CONTACT_EMAIL=
# Public URL of your Evidence Navigator deployment (adds "Plan this test" links from untested assumptions)
NAVIGATOR_URL=
# Coach limits on the server key
COACH_PER_HOUR=60
COACH_MAX_TOKENS=1200
# Largest PDF accepted (MB)
MAX_PDF_MB=25
PORT=3000
